<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Security Groups -->
    <record id="group_excel_connector_user" model="res.groups">
        <field name="name">Excel Connector User</field>
        <field name="category_id" ref="base.module_category_extra_tools"/>
    </record>

    <record id="group_excel_connector_manager" model="res.groups">
        <field name="name">Excel Connector Manager</field>
        <field name="category_id" ref="base.module_category_extra_tools"/>
        <field name="implied_ids" eval="[(4, ref('group_excel_connector_user'))]"/>
    </record>

    <!-- Record Rules -->
    <record id="excel_template_rule_user" model="ir.rule">
        <field name="name">Excel Template: User sees own</field>
        <field name="model_id" ref="model_excel_template"/>
        <field name="domain_force">[('responsible_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_excel_connector_user'))]"/>
    </record>

    <record id="excel_template_rule_manager" model="ir.rule">
        <field name="name">Excel Template: Manager sees all</field>
        <field name="model_id" ref="model_excel_template"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_excel_connector_manager'))]"/>
    </record>
</odoo>
